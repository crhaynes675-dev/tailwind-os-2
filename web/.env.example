# Copy to .env.local and point at whatever backend you want to develop against.
# With no .env present the app targets PRODUCTION (see src/lib/config.ts), so
# set these before doing anything that writes data or moves money.

# API Gateway base URL, no trailing slash
VITE_API_BASE=https://92hhz60r9e.execute-api.us-east-1.amazonaws.com/prod

# Cognito
VITE_COGNITO_URL=https://cognito-idp.us-east-1.amazonaws.com/
VITE_COGNITO_CLIENT_ID=gikbjh82ul60up99pvanoar2p

# Anything other than "production" shows an environment banner in the app,
# so nobody mistakes staging data for the real thing.
VITE_ENV_NAME=local
